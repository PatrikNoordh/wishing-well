# Public values only: everything prefixed EXPO_PUBLIC_ is built into the app.
# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Secrets never go here. Edge Function secrets (AI_PROVIDER, AI_MODEL, provider API keys)
# are set with `npx supabase secrets set` by the developer.
