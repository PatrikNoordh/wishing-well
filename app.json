{
  "expo": {
    "name": "Wishing Well",
    "slug": "wishing-well",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wishingwell",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "se.noordh.wishingwell",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Wishing Well uses the camera so you can photograph something you wish for.",
        "NSPhotoLibraryUsageDescription": "Wishing Well opens your photos so you can add a picture or a screenshot to a wish."
      }
    },
    "android": {
      "package": "se.noordh.wishingwell",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "sv": "./src/locales/native/sv.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
